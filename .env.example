# 复制为 .env 后按需填写：cp .env.example .env
# 已存在的系统环境变量优先，不会被 .env 覆盖

# ---------- AI Provider ----------
# 两个 Key 都不填 → 自动进入 mock 模式，前端仍可完整联调
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# 默认 Provider：deepseek 或 kimi
DEFAULT_AI_PROVIDER=deepseek

# /api/chat 未显式指定 ai_provider 时用的 Provider（留空则跟随 DEFAULT_AI_PROVIDER）
GENERAL_CHAT_PROVIDER=

# ---------- 模型与接入点（一般不用改） ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash
# 带图片的请求会自动切换到视觉模型
DEEPSEEK_VISION_MODEL_NAME=deepseek-v4-flash-vision-exp

KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_NAME=kimi-k3

# OpenAI（原生 OpenAI API，也可指向任意 OpenAI 兼容端点）
OPENAI_API_KEY=
# Azure Foundry 示例：https://your-resource.openai.azure.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 填模型名（gpt-4o / gpt-5 …）；Azure 填“部署名”（例如 gpt-5.6-sol）
OPENAI_MODEL_NAME=gpt-4o
# 认证头：auto（识别到 Azure 域名自动同时带 api-key）/ bearer / api-key
OPENAI_AUTH_MODE=auto

# ---------- Mock / 请求行为 ----------
# auto（默认）：有 Key 走真实调用，无 Key 返回 mock
# true：强制 mock      false：无 Key 时直接报错
AI_MOCK_MODE=auto
# mock 回复的模拟耗时（秒），让 /api/chat_async 的轮询过程可见
AI_MOCK_DELAY_SECONDS=0.5
AI_REQUEST_TIMEOUT_SECONDS=360
# 工具调用循环的轮次上限（默认 15）。达到上限不再报错，而是再发一次「不带工具」的请求让模型收尾；
# 请求体里传 "max_tool_iterations": N 可以按次覆盖（会被夹到 1~50）。
MAX_TOOL_ITERATIONS=15
# 同一个 (工具, 参数) 最多执行几次；超过就不再执行并收尾（默认 2，防模型死循环刷同一调用）
MAX_IDENTICAL_TOOL_CALLS=2
# 同一个工具连续失败几次后，在工具结果里追加「别再重试它」的提示（默认 3）
MAX_TOOL_ERRORS_BEFORE_NOTICE=3
# 连接测试（POST /api/test_connection）的硬超时（秒）
TEST_CONNECTION_TIMEOUT_SECONDS=15

# ---------- 服务与鉴权 ----------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO
# 第三方库日志级别（默认压噪）：AZURE_LOG_LEVEL 默认 ERROR，HTTP_LOG_LEVEL 默认 WARNING
# AZURE_LOG_LEVEL=ERROR
# HTTP_LOG_LEVEL=WARNING
# 同步路由线程池上限（长请求多时可调大，避免其他接口排队）
MAX_SYNC_THREADS=64
# 关掉 uvicorn 访问日志（每个请求一行）可设 false
# ACCESS_LOG=true

# 生产环境务必改掉
JWT_SECRET=your-very-secret-key-change-it-in-production
JWT_EXPIRATION_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# ---------- Google 登录（OAuth 2.0 Authorization Code + PKCE）----------
# 在 Google Cloud Console 创建“桌面应用”OAuth Client，并把 Client ID 填在这里。
# 本地默认回调：http://127.0.0.1:<PORT>/api/auth/google/callback
GOOGLE_CLIENT_ID=
# 桌面应用通常不需要；只有使用 Web Application 类型客户端时才填写。
GOOGLE_CLIENT_SECRET=
# 后端地址/端口固定或部署到远端时建议显式设置，并在 Google Cloud Console 注册同一 URI。
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=300
# 强烈建议至少配置一个允许范围；两项都为空时，任何已验证 Google 账号均可登录。
# GOOGLE_ALLOWED_EMAILS=alice@example.com,bob@example.com
# GOOGLE_ALLOWED_DOMAINS=example.com

# ---------- GitHub 登录（OAuth Device Flow）----------
# 在 GitHub → Settings → Developer settings → OAuth Apps 创建应用并启用 Device Flow。
GITHUB_CLIENT_ID=
GITHUB_OAUTH_STATE_TTL_SECONDS=900
# 强烈建议至少配置一个允许范围；两项都为空时，任何 GitHub 账号均可登录。
# GITHUB_ALLOWED_LOGINS=octocat,another-user
# GITHUB_ALLOWED_EMAILS=alice@example.com

# ---------- 会话 / 任务（SQLite 持久化）----------
# 数据库默认位置：~/Library/Application Support/AIChatApp/aichat.db
# 只有想换位置（比如放进项目目录或测试用）时才需要设置下面这行
# AICHAT_DB_PATH=/tmp/aichat.db
MAX_HISTORY_MESSAGES=40
# 任务记录保留时长，每次查询任务时清理过期记录
TASK_TTL_HOURS=24
# 测试用：秒级 TTL，优先级高于 TASK_TTL_HOURS（例如 TASK_TTL_SECONDS=1）
# TASK_TTL_SECONDS=1
MAX_CHAT_IMAGES=5
MAX_CHAT_FILES=5
MAX_FILE_CHARS=50000

# ---------- Azure 工具（/api/chat 里 enable_tools=true 才会用到）----------
# 服务主体凭据（DefaultAzureCredential 会自动读取这三个变量）
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Python 客户端默认订阅；也可在请求里传 subscription_id 覆盖
AZURE_SUBSCRIPTION_ID=
# 没有服务主体时，设为 true 可改用 az login / 托管身份（DefaultAzureCredential 默认链路）
AZURE_USE_DEFAULT_CREDENTIAL=false
# /api/health 里 azure.configured 的探测参数：
# 探测在后台线程里做（/api/health 不阻塞），没探完会先返回 credential_source=probing
AZURE_PROBE_TIMEOUT_SECONDS=8
AZURE_PROBE_CACHE_SECONDS=30
# 后台刷新间隔（秒），0 表示关闭自动刷新
AZURE_PROBE_REFRESH_SECONDS=30

# ---------- Meraki 工具 ----------
MERAKI_API_KEY=
# 一般不用改；自建代理或区域化端点时才需要
MERAKI_BASE_URL=https://api.meraki.com/api/v1
# 用 Dashboard API Key 时留空（走 X-Cisco-Meraki-API-Key）；用 OAuth token 时设为 bearer
MERAKI_AUTH_HEADER=

# ---------- Cisco Nexus Dashboard 工具（官方 Infra API + Manage API）----------
# 集群地址，形如 https://nd.example.com（只填主机，不要带 /api/v1/...，代码自己拼）
ND_BASE_URL=
# 认证方式二选一（同时填了优先 API Key）：
#   1) API Key：Nexus Dashboard 右上角用户名 → Manage API keys → Add API key；
#      请求头走 X-Nd-Username + X-Nd-Apikey，账号必须是 local 账号
#   2) 用户名密码：后端调 POST /api/v1/infra/login 换 token（自动缓存/续期）
ND_USERNAME=
ND_API_KEY=
ND_PASSWORD=
# 密码模式的登录域，默认 local
ND_LOGIN_DOMAIN=local
# 是否校验 TLS 证书：Nexus Dashboard 出厂多为自签证书，默认 false（等同官方示例的 --insecure）
ND_VERIFY_TLS=false
# 单次请求超时（秒）与登录 token 缓存时长（秒）
ND_TIMEOUT=30
ND_TOKEN_TTL_SECONDS=600

# ---------- Serverless 容器（多容器注册表）----------
# 容器代码在 GitHub（例如 gtsdrt/Azure_ACR），GitHub Actions 构建镜像推到 ACR，
# 以 Azure Container Apps 运行。注册表是「哪些容器可以被 AI 调用」的唯一来源。
#
# 首选方式：注册表文件（App 设置页会写这一份，后端每次调用都重读 → 改完立即生效，不用重启）
#   ~/Library/Application Support/AIChatApp/containers.json
#   格式：{"containers":[{"name":"ansible","url":"https://xxx.azurecontainerapps.io",
#                        "api_key":"...","mode":"auto","allowed_tasks":["..."],"timeout":300}]}
#   也可以用 AICHAT_CONTAINERS_FILE 指定别的路径，或用 CONTAINER_ENDPOINTS_JSON 直接塞 JSON。
#
# 下面三个是「旧的单容器写法」，仍然兼容（会被当成一个名为 ANSIBLE_EXECUTOR_NAME 的条目）：
ANSIBLE_EXECUTOR_URL=
# 容器里的 API_KEY 环境变量（请求头 X-API-Key）；注册表里用 api_key_env 指向它。
# 注意：打包版 App 不会自动设置这个变量，它只在「开发模式 / CI / 手动 export」时有效；
# 打包版请用 App 设置页（存 Keychain）或直接写注册表的 api_key。
ANSIBLE_EXECUTOR_API_KEY=
# 旧写法的白名单，逗号分隔：留空 -> 只放行只读任务；* -> 不限制（危险）；a,b -> 自定义
ANSIBLE_ALLOWED_TASKS=
# 单次执行超时（秒）：ansible 任务可能跑几分钟，默认 300
ANSIBLE_EXECUTOR_TIMEOUT=300
